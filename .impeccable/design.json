      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Public-site Bootstrap variant with the existing uppercase Oswald label and state colors.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">See user documentation</button>",
      "css": ".ds-button-primary{display:inline-block;border:1px solid transparent;border-radius:.25rem;padding:.375rem .75rem;font-family:Oswald,sans-serif;font-size:1rem;font-weight:400;line-height:1.5;text-transform:uppercase;text-align:center;color:#fff;cursor:pointer;transition:color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out,box-shadow .15s ease-in-out;background:#007bff;border-color:#007bff;}.ds-button-primary:hover{background:#0069d9;border-color:#0062cc}.ds-button-primary:focus,.ds-button-primary:focus-visible{outline:0;background:#0069d9;border-color:#0062cc;box-shadow:0 0 0 .2rem rgba(38,143,255,.5)}.ds-button-primary:active{background:#0062cc;border-color:#005cbf}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
