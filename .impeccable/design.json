      "css": ".ds-doc-nav{background:#f5f6fa;font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;font-size:1rem}.ds-doc-link{display:block;min-height:3rem;padding:.25rem 3rem .25rem 1rem;line-height:2.5rem;color:#7253ed;text-decoration:none;outline-offset:-1px}.ds-doc-link:hover,.ds-doc-active{color:rgb(95.0763157895,59.9157894737,234.5842105263);background-image:linear-gradient(-90deg,rgb(234.8,236.82,244.9) 0%,rgba(234.8,236.82,244.9,.8) 80%,rgba(234.8,236.82,244.9,0) 100%)}.ds-doc-link:focus-visible{outline-offset:-1px}.ds-doc-active{font-weight:600}@media(min-width:50rem){.ds-doc-link{min-height:2rem;line-height:1.5rem;padding-right:2rem;padding-left:2rem}}"
