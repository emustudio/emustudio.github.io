    {
      "name": "Getting-started Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat public-site card with a light outline and an instructional heading.",
      "html": "<section class=\"ds-card\"><h5 class=\"ds-card-title\">What can I do as a user?</h5><p class=\"ds-card-copy\">See user documentation for application workflows and computer guides.</p></section>",
      "css": ".ds-card{padding:1.25rem;background:#fff;color:#212529;border:1px solid rgba(0,0,0,.125);border-radius:.25rem;font-family:\"Roboto Condensed\",sans-serif;font-size:18px;line-height:30px}.ds-card-title{margin:0 0 .5rem;font-family:Oswald,sans-serif;font-size:1.25rem;font-weight:500;line-height:1.2}.ds-card-copy{margin:0 0 30px}"
    },
    {
      "name": "Public Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Dark navigation band; the preview isolates its brand and link states rather than fixing it to the viewport.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Website\"><a class=\"ds-nav-brand\" href=\"#home\">emuStudio</a><a class=\"ds-nav-link ds-nav-current\" href=\"#download\" aria-current=\"page\">Download</a><a class=\"ds-nav-link\" href=\"#screenshots\">Screenshots</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;flex-wrap:wrap;gap:1rem;padding:.5rem 1rem;background:#343a40;font-family:\"Roboto Condensed\",sans-serif;font-size:16px;line-height:30px}.ds-nav a{outline:none;text-decoration:none;transition:all 225ms ease}.ds-nav-brand{color:#fff}.ds-nav-link{color:rgba(255,255,255,.5);text-transform:uppercase}.ds-nav-link:hover,.ds-nav-link:focus-visible{color:rgba(255,255,255,.75)}.ds-nav-current{color:#fff}"
    },
    {
      "name": "Documentation Search",
      "kind": "input",
      "refersTo": "docs-search",
      "description": "Square, borderless theme search field with its focus-colored icon. The snippet is a visual primitive, not a search engine.",
      "html": "<div class=\"ds-search\"><input class=\"ds-search-input\" id=\"ds-doc-search\" type=\"search\" placeholder=\"Search emuStudio documentation\"/><label class=\"ds-search-label\" for=\"ds-doc-search\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"m15 15 6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg><span class=\"ds-search-label-text\">Search documentation</span></label></div>",
      "css": ".ds-search{position:relative;height:3.75rem;background:#fff;font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif}.ds-search-input{position:absolute;width:100%;height:100%;padding:.5rem 1rem .5rem 2.5rem;font:inherit;font-size:1rem;color:#5c5962;background:#fff;border:0;border-radius:0;box-sizing:border-box}.ds-search-input:focus,.ds-search-input:focus-visible{outline-offset:-1px}.ds-search-label{position:absolute;inset:0 auto 0 1rem;display:flex;align-items:center;pointer-events:none}.ds-search-label svg{width:1.2rem;height:1.2rem;color:#959396}.ds-search-input:focus+.ds-search-label svg{color:#7253ed}.ds-search-label-text{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}@media(min-width:50rem){.ds-search-input{padding-left:3.5rem;font-size:.875rem;transition:padding-left linear 200ms}.ds-search-label{left:2rem}}"
