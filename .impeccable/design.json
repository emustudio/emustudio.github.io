      "css": ".ds-button-secondary{display:inline-block;border:1px solid transparent;border-radius:.25rem;padding:.375rem .75rem;font-family:Oswald,sans-serif;font-size:1rem;font-weight:400;line-height:1.5;text-transform:uppercase;text-align:center;color:#fff;cursor:pointer;transition:color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out,box-shadow .15s ease-in-out;background:#6c757d;border-color:#6c757d;}.ds-button-secondary:hover{background:#5a6268;border-color:#545b62}.ds-button-secondary:focus,.ds-button-secondary:focus-visible{outline:0;background:#5a6268;border-color:#545b62;box-shadow:0 0 0 .2rem rgba(130,138,145,.5)}.ds-button-secondary:active{background:#545b62;border-color:#4e555b}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}"
